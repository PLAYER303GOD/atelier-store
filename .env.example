# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (Neon console -> Connect).
# Use the pooled host (contains "-pooler") for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Better Auth
# Generate a secret: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
